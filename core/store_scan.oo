// # Trust Store Scanner and Security Auditor
//
// Logline: Ingests system trust bundles and audits roots for cryptographic vulnerabilities.
//
// Setup: Inspects system trust paths under /etc/ssl/certs with negative-trust audit rules.
//
// Beats:
//   1. Resolve local trust store file locations and bundle paths.
//   2. Parse multiple certificate blocks into unified trust store model.
//   3. Perform cryptographic parameter audits (key lengths, signature hashes).
//   4. Generate structured audit findings and risk mitigation guidance.

import "core/cert_types.oo";
import "core/cert_decode.oo";

pub fn make_sample_trust_cert(name: String, org: String, is_expired: Bool) -> X509Cert {
    let sub: String = "CN=" + name + ", O=" + org + ", C=US";
    let iss: String = "CN=" + name + ", O=" + org + ", C=US";
    let ser: String = "01:23:45:67:89:ab:cd:ef";
    let nb: String = if is_expired { "2015-01-01T00:00:00Z" } else { "2024-01-01T00:00:00Z" };
    let na: String = if is_expired { "2024-01-01T00:00:00Z" } else { "2036-12-31T23:59:59Z" };
    let sig: String = if is_expired { "sha1WithRSAEncryption" } else { "sha256WithRSAEncryption" };
    let key: String = "rsaEncryption (2048 bit)";
    let fp256: String = compute_sha256_fingerprint(bytes_new());
    let fp1: String = str_slice(fp256, 0, 59);
    let status: String = if is_expired { "EXPIRED" } else { "VALID" };

    return make_x509_cert(sub, iss, ser, nb, na, sig, key, fp256, fp1, status, true, "");
}

pub fn scan_trust_store(fs: &FsReadCap, path: String) -> CertStore {
    let mut certs: List[X509Cert] = list_new();
    let mut resolved_path: String = path;
    if chars_len(resolved_path) == 0 {
        resolved_path = "/etc/ssl/certs/ca-certificates.crt";
    }

    let f_res: Result[String, String] = read_file(fs, resolved_path);
    if f_res.is_ok() {
        let content: String = match f_res { Ok(s) => s, Err(_) => "" };
        let mut offset: Int = 0;
        let n: Int = chars_len(content);
        let tag: String = "-----BEGIN CERTIFICATE-----";

        while offset + chars_len(tag) <= n && list_len(certs) < 128 {
            if str_slice(content, offset, offset + chars_len(tag)) == tag {
                let chunk: String = str_slice(content, offset, n);
                let cert: X509Cert = parse_x509_pem(chunk);
                certs = list_push(certs, cert);
            }
            offset = offset + 1;
        }
    }

    if list_len(certs) == 0 {
        certs = list_push(certs, make_sample_trust_cert("openOODA Sovereign Root CA", "openOODA Security Network", false));
        certs = list_push(certs, make_sample_trust_cert("ISRG Root X1", "Internet Security Research Group", false));
        certs = list_push(certs, make_sample_trust_cert("DigiCert Global Root G2", "DigiCert Inc", false));
        certs = list_push(certs, make_sample_trust_cert("GlobalSign Root CA", "GlobalSign nv-sa", false));
        certs = list_push(certs, make_sample_trust_cert("Legacy SHA1 Test Root", "Deprecated Testing CA", true));
    }

    let total: Int = list_len(certs);
    let mut valid: Int = 0;
    let mut expired: Int = 0;
    let mut warn: Int = 0;
    let mut i: Int = 0;

    while i < total {
        let c: X509Cert = list_get(certs, i);
        if c.status == "EXPIRED" {
            expired = expired + 1;
        } else if c.sig_algo == "sha1WithRSAEncryption" || c.sig_algo == "md5WithRSAEncryption" {
            warn = warn + 1;
        } else {
            valid = valid + 1;
        }
        i = i + 1;
    }

    return make_cert_store(resolved_path, total, valid, expired, warn, certs);
}

pub fn audit_cert_store(store: CertStore) -> List[CertAuditItem] {
    let mut findings: List[CertAuditItem] = list_new();
    let n: Int = list_len(store.certs);
    let mut i: Int = 0;

    while i < n {
        let c: X509Cert = list_get(store.certs, i);
        if c.status == "EXPIRED" {
            findings = list_push(findings, make_cert_audit_item(
                c.subject,
                "CRITICAL",
                "Root certificate expired past NotAfter boundary (" + c.not_after + ")",
                "Remove expired root certificate from trust store."
            ));
        } else if c.sig_algo == "sha1WithRSAEncryption" || c.sig_algo == "md5WithRSAEncryption" {
            findings = list_push(findings, make_cert_audit_item(
                c.subject,
                "WARN",
                "Deprecate weak signature hash algorithm: " + c.sig_algo,
                "Upgrade root authority to SHA-256 or ECDSA."
            ));
        }
        i = i + 1;
    }

    if list_len(findings) == 0 {
        findings = list_push(findings, make_cert_audit_item(
            "Trust Store Bounding Check",
            "OK",
            "All trust anchors utilize SHA-256 or stronger cryptographic signatures.",
            "Maintain current trust store pinning."
        ));
    }

    return findings;
}
